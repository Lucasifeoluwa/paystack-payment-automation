# Copy to .env and fill in. Never commit .env.

# Paystack TEST secret key, starts with sk_test_ (Dashboard > Settings > API Keys & Webhooks).
# Used to verify webhook signatures and to call the Paystack API in the daily sweep.
# The test script refuses to run with an sk_live_ key.
PAYSTACK_SECRET_KEY=

# Airtable base and table IDs (from the Airtable URL: airtable.com/appXXXX/tblYYYY/...)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_PAYMENTS_TABLE_ID=tblXXXXXXXXXXXXXX

# Slack incoming webhook for sale, rejection and failure alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Sender address for receipt emails (the SMTP credential itself lives in n8n)
RECEIPT_FROM_EMAIL=payments@example.com

# Where the test script sends webhooks. With docker compose running locally:
N8N_WEBHOOK_URL=http://localhost:5678/webhook/paystack-webhook

# Timezone for the daily sweep schedule
GENERIC_TIMEZONE=Africa/Lagos
